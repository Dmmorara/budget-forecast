PORT=8000

# ─── Wasaa Lifestyle staging sandbox ───
# Copy this file to .env and fill in the real values. .env is gitignored and
# must stay that way: a credential committed once stays in the history even
# after it is deleted.
#
# Staging only. Never production, never live M-Pesa.
WASAA_API_BASE_URL=https://staging.example.wasaalifestyle.com
WASAA_API_EMAIL=
WASAA_API_PASSWORD=

# Normally leave this BLANK. Only set it to a CA certificate your institution
# publishes for its own TLS-inspecting proxy, obtained from the institution.
#
# Never point it at a certificate scraped off a failing connection. On a
# network running TLS inspection that is the interceptor's own certificate,
# and trusting it defeats the check entirely. If verification fails, read the
# issuer first:
#
#   openssl s_client -connect <host>:443 -servername <host> </dev/null 2>/dev/null \
#     | openssl x509 -noout -subject -issuer -dates
#
# An issuer naming a firewall vendor means the network is intercepting, not
# that the server is broken. Switch networks rather than lowering the bar.
WASAA_API_CA_BUNDLE=
